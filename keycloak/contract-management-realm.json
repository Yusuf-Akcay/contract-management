{
  "realm": "contract-management",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "contract-read", "description": "Read customers and contracts (REST + MCP)" },
      {
        "name": "contract-write",
        "description": "Create, update and delete customers and contracts (includes contract-read)",
        "composite": true,
        "composites": { "realm": ["contract-read"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "contract-management",
      "name": "Contract Management API (curl, Swagger, smoke test)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-contract-management",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "contract-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "contract-management-ui",
      "name": "Contract Management UI (React, demo)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:4173/*", "http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-contract-management",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "contract-management",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "clerk",
      "enabled": true,
      "firstName": "Clara",
      "lastName": "Clerk",
      "email": "clerk@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["contract-write"]
    },
    {
      "username": "auditor",
      "enabled": true,
      "firstName": "Arne",
      "lastName": "Auditor",
      "email": "auditor@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["contract-read"]
    }
  ]
}
